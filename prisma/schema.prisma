generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Element {
  FIRE
  WATER
  EARTH
  DARK
  LIGHT
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

// Gold 变动的原因。每一条流水都要说明"为什么变"。
enum LedgerType {
  SIGNUP_BONUS // 注册奖励
  DAILY_LOGIN // 每日登录奖励
  QUEST_REWARD // 完成委托的奖励
  SALE_INCOME // 卖卡收入
  PURCHASE // 买卡支出
  FEE // 交易手续费
  TOP_UP // 模拟充值
  TRADE_GOLD // 卡牌交换时附带的 Gold
}

// 挂单的状态机：AVAILABLE → RESERVED → SOLD，或 AVAILABLE → CANCELLED / EXPIRED。
// 状态只能沿着允许的路径变化，每一次变化都用"条件更新"来保证。
enum ListingStatus {
  AVAILABLE // 在售
  RESERVED // 被买家保留：保留期内只有保留者能买
  SOLD // 已售出
  CANCELLED // 卖家取消
  EXPIRED // 挂单本身过期（暂未使用）
}

// 保留的状态机：ACTIVE → PURCHASED（买下了），或 ACTIVE → EXPIRED（超时）/ CANCELLED（买家主动放弃）。
// 后三种都是终点，状态不会再变。
enum ReservationStatus {
  ACTIVE
  PURCHASED
  EXPIRED
  CANCELLED
}

// 付款的状态机：PENDING → SUCCEEDED 或 FAILED，两个终点之后不再变。
enum PaymentStatus {
  PENDING // 已记录、正在向支付服务商扣款
  SUCCEEDED // 扣款成功，Gold 已入账
  FAILED // 扣款失败，没有入账
}

// 评价时可以选的标签（最多 3 个）。
enum ReviewTag {
  FAST_TRADER
  GOOD_COMMUNICATION
  FAIR_PRICE
}

// 官方卡牌：由系统管理，玩家只读。
model Card {
  id          String          @id @default(cuid())
  number      Int             @unique // 图鉴编号（显示为 #001），对外稳定
  name        String          @unique
  description String
  element     Element
  rarity      Rarity
  attack      Int
  defense     Int
  imageUrl    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inventory   InventoryItem[]
  listings    Listing[]
  orders      Order[]

  @@index([element])
  @@index([rarity])
}

// ---------------------------------------------------------------------
// 经济系统：玩家拥有的卡牌和 Gold
// ---------------------------------------------------------------------

// 玩家的仓库：某个玩家拥有某张卡几张。
// 一个玩家对一张卡只有一行（userId + cardId 唯一），数量用 quantity 表示。
model InventoryItem {
  id               String   @id @default(cuid())
  userId           String
  cardId           String
  quantity         Int // 拥有的总数
  reservedQuantity Int      @default(0) // 被挂单/交换/委托锁住的数量；可用数量 = quantity - reservedQuantity
  isHidden         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([userId, cardId])
  @@index([userId])
}

// 玩家的钱包。balance 只是"流水总和"的缓存，
// 唯一允许修改它的方式是同时写一条 LedgerEntry（见 wallet.service.ts）。
model Wallet {
  userId        String   @id
  balance       Int      @default(0) // 可用 Gold
  frozenBalance Int      @default(0) // 被委托/交换冻结的 Gold
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Gold 流水：每一次 Gold 变动都留下一行，只增不改不删。
model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  amount       Int // 正数收入，负数支出
  type         LedgerType
  refType      String? // 关联的业务，例如 "Order"、"Quest"
  refId        String? // 关联业务的 id
  balanceAfter Int // 这次变动之后的余额，方便核对
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 市场上的一个挂单：卖家把仓库里的 quantity 张某卡，按 unitPrice 一张出售。
// 一个挂单是一整份：买家要买就整份买下（总价 = quantity × unitPrice）。
// 挂单创建时，卖家仓库里对应数量会被锁住（InventoryItem.reservedQuantity 增加）。
model Listing {
  id        String        @id @default(cuid())
  sellerId  String
  cardId    String
  quantity  Int
  unitPrice Int // 每张的价格（Gold）
  status    ListingStatus @default(AVAILABLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  seller    User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  card      Card          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  order     Order?
  reservations Reservation[]

  @@index([status, cardId])
  @@index([sellerId, status])
}

// 保留：买家在 expiresAt 之前独占一个挂单，别人不能买。
// 保留不冻结 Gold（买家可以保留之后再赚够钱）；防止滥用靠"同时最多保留几个"的上限。
// 保留一个挂单时，挂单的状态同时从 AVAILABLE 变成 RESERVED（见 market.service.ts）。
model Reservation {
  id        String            @id @default(cuid())
  listingId String
  buyerId   String
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  listing   Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([status, expiresAt]) // 过期扫描："找出所有已经超时的 ACTIVE 保留"
}

// 一次充值付款。
// 关键字段 idempotencyKey（幂等键）：客户端每次"结账"生成一个随机 id 一起发来。
// (userId, idempotencyKey) 唯一，所以同一次结账不管请求被发送多少遍
// （连点两次、网络超时后重试），数据库里都只会有一条付款，也就只会扣一次款、加一次 Gold。
// gold 和 amountCents 是下单那一刻的"快照"：以后调整商品价格，不影响历史记录。
model Payment {
  id                    String        @id @default(cuid())
  userId                String
  idempotencyKey        String
  packId                String
  gold                  Int
  amountCents           Int
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  providerTransactionId String? // 支付服务商那边的交易号
  failureReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

// 一笔成交记录：一个挂单被买下之后产生一条，之后不再修改（只增不改）。
// listingId 唯一：一个挂单最多只会成交一次。
// 买家、卖家、卡牌用 Restrict：成交记录是财务凭证，不能因为删用户或删卡而连带消失。
model Order {
  id         String   @id @default(cuid())
  buyerId    String
  sellerId   String
  listingId  String   @unique
  cardId     String
  quantity   Int
  unitPrice  Int
  totalPrice Int // quantity × unitPrice
  fee        Int // 手续费（从卖家收入里扣）
  createdAt  DateTime @default(now())
  buyer      User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller     User     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)
  reviews    Review[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

// 评价：一笔成交之后，买卖双方各自可以给对方评一次。
// (orderId, reviewerId) 唯一：同一个人对同一笔订单只能评一次，由数据库保证，
// 不靠"前端把按钮藏起来"。
// targetId（被评的人）不由客户端传，服务器根据订单推出来：
// 评价者是买家，被评的就是卖家；反之亦然。这样没人能给不相干的人刷好评或差评。
// 评价是信誉凭证，所以关联用 Restrict，不会因为删用户而连带消失。
model Review {
  id         String      @id @default(cuid())
  orderId    String
  reviewerId String
  targetId   String
  rating     Int // 1 到 5 星
  tags       ReviewTag[]
  comment    String?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewer   User        @relation("ReviewWriter", fields: [reviewerId], references: [id], onDelete: Restrict)
  target     User        @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([orderId, reviewerId])
  @@index([targetId, createdAt]) // 查"某个人收到的评价"和算平均分
}

// ---------------------------------------------------------------------
// 以下四张表是 Better Auth 需要的标准结构（账号、登录状态、验证码）。
// 字段名由这个库规定，不要改名；以后需要的自定义字段（例如 role）
// 再通过它的 additionalFields 加进 User。
// @@map 让数据库里的表名是小写的 user / session / account / verification。
// ---------------------------------------------------------------------

// 一个人。注意：密码不在这里，在 Account 里。
model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  inventory     InventoryItem[]
  wallet        Wallet?
  ledgerEntries LedgerEntry[]
  listings      Listing[]
  ordersBought  Order[]       @relation("OrderBuyer")
  ordersSold    Order[]       @relation("OrderSeller")
  reservations  Reservation[]
  payments      Payment[]
  reviewsWritten  Review[]    @relation("ReviewWriter")
  reviewsReceived Review[]    @relation("ReviewTarget")

  @@map("user")
}

// 一次"已登录"的状态，每个设备/浏览器一条。
// 浏览器的 cookie 里存的是 token，服务器用它查到这一行，就知道是谁。
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// 一种登录方式。邮箱密码登录是 providerId = "credential" 的一行，
// 密码（已加密）存在这里。以后加 Google 登录，就是同一个 User 多一行 Account。
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// 一次性验证码（邮箱验证、重设密码）。现在还没用到，但库要求这张表存在。
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
